# ==============================================================================
# RoadWatch Backend - Environment Variables Configuration
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=roadwatch-production-secret-key-change-in-prod-xyz123
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS Configuration (Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# MongoDB Database Configuration (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=roadwatch_db

# Media Storage Configuration (Local folder or Render Persistent Disk mount)
# Zero AWS S3 dependency. Render mounts persistent volume at /var/data/media
MEDIA_ROOT=media

# Microservices & Workers
AI_SERVICE_URL=http://127.0.0.1:8001
REDIS_URL=redis://localhost:6379/0

# JWT Auth Tokens
JWT_SECRET=roadwatch-jwt-secret-key-change-in-prod-xyz123
JWT_EXPIRATION_HOURS=72

# Optional SMTP Email Configuration (for production notification emails)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
